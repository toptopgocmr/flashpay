APP_NAME=FlashPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# Dev local : SQLite (aucun serveur à installer, fichier database/database.sqlite)
# Pour MySQL (XAMPP/Laragon), commentez la ligne ci-dessus et décommentez :
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flashpay
DB_USERNAME=root
DB_PASSWORD=

# L'admin Vue est désormais servie par Laravel lui-même sous /admin (même
# origine), ce réglage n'est donc plus nécessaire pour elle. Conservé au cas
# où un autre client SPA externe consommerait l'API via cookies Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Rails de paiement ---

# ============================================
# PEEX PAYMENT GATEWAY (collecte / décaissement / remittance)
# Documentation: https://peex-api-docs.peexit.com/
# ============================================
PEEX_SANDBOX=true
PEEX_BASE_URL=https://sandbox.peexit.com/api/v1/
PEEX_PRODUCTION_URL=https://server.peexit.com/api/v1/
PEEX_SECRET_KEY=votre-cle-secrete-peex
PEEX_WEBHOOK_SECRET=your-peex-webhook-secret
# Identifiants Basic Auth que PEEX utilise pour appeler NOS callbacks
# (/api/webhooks/peex/collect | /disbursement | /remittance) — à communiquer au support PEEX.
PEEX_CALLBACK_USERNAME=peex
PEEX_CALLBACK_PASSWORD=peex_callback
# Pays par défaut d'un numéro saisi sans indicatif
PEEX_DEFAULT_COUNTRY=CG
# API PEEX pour créditer un numéro congolais : disbursement | remittance
PEEX_CG_PAYOUT_API=disbursement
# Contrôles avant opération (true en production)
PEEX_VERIFY_ACCOUNTS=true
PEEX_VERIFY_WALLET_PATH=clients/verify_wallet
PEEX_CHECK_BALANCE=true
PEEX_UNKNOWN_GRACE_MINUTES=10
# Délai pour valider un paiement mobile money sur le téléphone (secondes) ; au-delà : échec « délai dépassé », rien n'est débité
PEEX_VALIDATION_TIMEOUT_SECONDS=180

# DIGITWACE / WACEPAY (versements remittance) — clés : tableau de bord WacePay › Developers
# Doc : https://docs.digitwace.com (PayIn : payinws.wacepay.com, jeton via GET get-token + Authorization Basic)
# Ne JAMAIS mettre la clé privée dans l'app mobile ni dans Git : variables Railway uniquement.
DIGITWACE_ENABLED=false
DIGITWACE_SANDBOX=true
DIGITWACE_BASE_URL=https://payinws.wacepay.com/api/v1/
DIGITWACE_AUTH_MODE=basic
DIGITWACE_PUBLIC_KEY=
DIGITWACE_PRIVATE_KEY=
# Partenaire de versement par défaut (ISO2, ex. SN,CI) — se règle plutôt dans la console : Pays & change › Partenaire
DIGITWACE_PAYOUT_COUNTRIES=
# payerCode forcés (sinon recherche automatique) : CG:MTN=XXXX,SN:ORANGE=YYYY
DIGITWACE_PAYER_CODES=
# Webhook : {APP_URL}/api/webhooks/digitwace — secret de signature HMAC-SHA256 et/ou jeton dans l'URL
DIGITWACE_WEBHOOK_SECRET=
DIGITWACE_SIGNATURE_HEADER=X-Wace-Signature
DIGITWACE_WEBHOOK_TOKEN=
DIGITWACE_WEBHOOK_IPS=
# Chemins d'API (à aligner sur la doc WacePay « Read the docs »)
DIGITWACE_PATH_LOGIN=get-token
DIGITWACE_PATH_SENDER=sender/create
DIGITWACE_PATH_BENEFICIARY=beneficiary/create
DIGITWACE_PATH_PAYERS=transaction/payercode
DIGITWACE_PATH_WALLET=transaction/wallet/create
DIGITWACE_PATH_CONFIRM=transaction/confirm
DIGITWACE_PATH_STATUS=transaction/status/{ref}
DIGITWACE_PATH_PAYIN=create
# Collecte carte Visa / Mastercard et compte bancaire (page de paiement WacePay)
DIGITWACE_PATH_PAYIN_CARD=payin/card
DIGITWACE_PATH_PAYIN_BANK=payin/bank
DIGITWACE_FIELD_PUBLIC_KEY=apiKey
DIGITWACE_FIELD_PRIVATE_KEY=secretKey


# --- Réseau cash FlashPay (config/payment_methods.php) ---
# Pays où FlashPay a des agents (dépôt cash par QR, retrait cash pickup)
FLASHPAY_AGENT_COUNTRIES=CG
# Pays où le retrait GAB est ouvert (vide = « bientôt disponible »)
FLASHPAY_ATM_COUNTRIES=
# Clé partagée avec la banque partenaire (header X-Partner-Key)
FLASHPAY_ATM_PARTNER_KEY=
FLASHPAY_VOUCHER_TTL_HOURS=72
FLASHPAY_VOUCHER_MAX=500000
FLASHPAY_AGENT_COMMISSION=50
FLASHPAY_PAY_CODE_TTL=120
FLASHPAY_PAY_CODE_MAX=200000

# ============================================
# Cahier des charges v1.5 — sécurité, notifications, plafonds
# ============================================
# Inscription avec OTP SMS, PIN obligatoire pour les opérations sortantes
FLASHPAY_REQUIRE_OTP=true
FLASHPAY_PIN_MANDATORY=true
# En sandbox/local : le code OTP est renvoyé dans la réponse API (debug_code)
FLASHPAY_OTP_DEBUG=true
FLASHPAY_OTP_NEW_DEVICE=true
# multi (plusieurs sessions, notification) | single (une seule session active)
FLASHPAY_DEVICE_POLICY=multi
# Dépôt agent saisi par numéro : confirmation du client par code SMS
FLASHPAY_CASHIN_CONFIRM=true
FLASHPAY_REFUND_DAYS=30
FLASHPAY_DYNAMIC_QR_TTL=180
FLASHPAY_VERIFY_AFTER=15

# Passerelle SMS/OTP : log (journal Laravel) | http (fournisseur réel)
FLASHPAY_SMS_DRIVER=log
FLASHPAY_SMS_URL=
FLASHPAY_SMS_TOKEN=
FLASHPAY_SMS_SENDER=FlashPay
# Push mobile : log | fcm
FLASHPAY_PUSH_DRIVER=log
FCM_SERVER_KEY=
# Numéro d'astreinte pour les alertes critiques (fraude, incident)
FLASHPAY_ADMIN_ALERT_PHONE=

# Plafonds KYC (XAF, indicatifs — à valider avec la conformité COBAC)
FLASHPAY_LIMITS_ENABLED=true
LIMIT_T0_OP=100000
LIMIT_T0_DAY=200000
LIMIT_T0_MONTH=500000
LIMIT_T0_BALANCE=500000
LIMIT_T1_OP=500000
LIMIT_T1_DAY=1000000
LIMIT_T1_MONTH=3000000
LIMIT_T1_BALANCE=2000000
LIMIT_T2_OP=2000000
LIMIT_T2_DAY=5000000
LIMIT_T2_MONTH=20000000
LIMIT_T2_BALANCE=10000000
FLASHPAY_AML_THRESHOLD=5000000
FLASHPAY_FRAUD_VELOCITY=10

# Support
FLASHPAY_SUPPORT_PHONE="+242 06 000 00 00"
FLASHPAY_PRO_PHONE="+242 05 000 00 00"
# Vérifier le solde WacePay avant chaque versement / alerte solde bas (XAF/XOF)
DIGITWACE_CHECK_BALANCE=true
DIGITWACE_LOW_BALANCE_ALERT=100000
# Carte et prélèvement bancaire : sandbox (page simulée) | wacepay | none
# FLASHPAY_CARD_DRIVER=wacepay
FLASHPAY_BANK_DEBIT_DRIVER=none

# Appels audio du chat (WebRTC) — TURN facultatif pour les réseaux 4G stricts
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# Chat traduit automatiquement : mymemory (gratuit, limité) | google | deepl
CHAT_TRANSLATION=true
CHAT_TRANSLATION_DRIVER=mymemory
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_KEY=
DEEPL_KEY=
